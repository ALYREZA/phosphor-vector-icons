{
  "name": "phosphor-vector-icons",
  "version": "0.1.0",
  "description": "Font-based Phosphor icon renderer for React web + React Native.",
  "license": "MIT",
  "author": "ALYREZA",
  "homepage": "https://github.com/ALYREZA/phosphor-vector-icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALYREZA/phosphor-vector-icons.git"
  },
  "bugs": {
    "url": "https://github.com/ALYREZA/phosphor-vector-icons/issues"
  },
  "keywords": [
    "phosphor",
    "icons",
    "react",
    "react-native",
    "font",
    "icon-font"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./react.js",
  "types": "./react.d.ts",
  "exports": {
    ".": {
      "react-native": "./react-native.js",
      "browser": "./react.js",
      "default": "./react.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "react.js",
    "react-native.js",
    "react.d.ts",
    "react-native.d.ts",
    "fonts",
    "glyphMap.json",
    "IconName.ts",
    "react-native.config.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ./copy-core-artifacts.mjs",
    "build": "tsup --config tsup.config.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "phosphor-core": "workspace:*",
    "phosphor-icons-react": "workspace:*",
    "phosphor-icons-react-native": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3"
  }
}
