{
  "name": "phosphor-vector-icons",
  "version": "0.0.0",
  "description": "Font-based Phosphor icon renderer for React web + React Native.",
  "type": "module",
  "main": "./react.js",
  "types": "./react.d.ts",
  "exports": {
    ".": {
      "react-native": "./react-native.js",
      "browser": "./react.js",
      "default": "./react.js"
    }
  },
  "files": [
    "react.js",
    "react-native.js",
    "react.d.ts",
    "react-native.d.ts",
    "fonts",
    "glyphMap.json",
    "IconName.ts",
    "react-native.config.js"
  ],
  "scripts": {
    "prebuild": "node ./copy-core-artifacts.mjs",
    "build": "tsup --config tsup.config.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "phosphor-core": "workspace:*",
    "phosphor-icons-react": "workspace:*",
    "phosphor-icons-react-native": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-native": ">=0.70"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3"
  }
}