{
  "name": "phosphor-vector-icons",
  "version": "0.1.2",
  "description": "Font-based Phosphor icon renderer for React web + React Native.",
  "license": "MIT",
  "author": "ALYREZA",
  "homepage": "https://github.com/ALYREZA/phosphor-vector-icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALYREZA/phosphor-vector-icons.git"
  },
  "bugs": {
    "url": "https://github.com/ALYREZA/phosphor-vector-icons/issues"
  },
  "keywords": [
    "phosphor",
    "icons",
    "react",
    "react-native",
    "font",
    "icon-font"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./react.js",
  "types": "./react.d.ts",
  "exports": {
    ".": {
      "react-native": "./react-native.js",
      "browser": "./react.js",
      "default": "./react.js"
    },
    "./thin": {
      "react-native": "./thin.native.js",
      "types": "./thin.d.ts",
      "default": "./thin.js"
    },
    "./light": {
      "react-native": "./light.native.js",
      "types": "./light.d.ts",
      "default": "./light.js"
    },
    "./regular": {
      "react-native": "./regular.native.js",
      "types": "./regular.d.ts",
      "default": "./regular.js"
    },
    "./bold": {
      "react-native": "./bold.native.js",
      "types": "./bold.d.ts",
      "default": "./bold.js"
    },
    "./fill": {
      "react-native": "./fill.native.js",
      "types": "./fill.d.ts",
      "default": "./fill.js"
    },
    "./duotone": {
      "react-native": "./duotone.native.js",
      "types": "./duotone.d.ts",
      "default": "./duotone.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "react.js",
    "react-native.js",
    "thin.js",
    "thin.native.js",
    "light.js",
    "light.native.js",
    "regular.js",
    "regular.native.js",
    "bold.js",
    "bold.native.js",
    "fill.js",
    "fill.native.js",
    "duotone.js",
    "duotone.native.js",
    "*.d.ts",
    "fonts",
    "glyphMap.json",
    "IconName.ts",
    "react-native.config.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ./copy-core-artifacts.mjs",
    "build": "tsup --config tsup.config.ts && node ./fix-dts.mjs",
    "prepack": "pnpm --filter phosphor-vector-icons^... build && pnpm build"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "phosphor-core": "workspace:*",
    "phosphor-icons-react": "workspace:*",
    "phosphor-icons-react-native": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3"
  }
}
